  "cross_city_synthesis": {
    "stagnation_paradox_diagnosis": {
      "core_thesis": "공공자전거의 성장성 정체(Saturation Plateau)는 시민들의 이용 의지가 꺾인 것이 아니라, '자본 동결 롱테일(Dead Capital)'과 '핵심 거점의 수요 질식(Choked Bottlenecks)'이라는 공간적 양극화의 덫(Spatial Polarization Trap)에 시스템이 갇혀 있기 때문이다.",
      "tashu_empirical_proof": {
        "polarization_gini": 0.564,
        "top10_trip_share": "40.5%",
        "bottom50_trip_share": "12.4%",
        "dormant_stations_le5_trips": "43.0%",
        "unmet_growth_potential": "+98.6% 추가 성장 가능 (일평균 14,635건 잠재 수요 복원 시)"
      },
      "seoul_empirical_proof": {
        "dock_capacity_choke_stations": "561개소 (전체 21.7%)",
        "explanation": "서울 전철역 300m 이내 초역세권 대여소 중 38% 이상이 거치대 수 10대 이하의 초소형 규격에 묶여 있음. 출근길 거치대 10대가 5분 만에 포화되어 추가 수요 유입이 원천 차단(Choked)됨."
      }
    },
    "actionable_unlock_strategy": {
      "strategy_1_reallocation": "Q2 자본 동결 대여소(일 5건 미만 43%)의 잉여 자전거를 회수하여 Q1 성장 억제 거점(역세권/주거유출지)으로 재배치",
      "strategy_2_virtual_overflow": "서울 따릉이 초역세권 만차 대여소에 가상 거치대(Geofence) 반납 구역 지정하여 물리 거치대 병목 철폐",
      "strategy_3_dynamic_mileage": "출퇴근 첨두 시 Q1 대여소(품절)에서 빌리거나 Q1 만차역 150m 인근 Q3/Q4 대여소에 반납하는 이용자에게 파격 마일리지 지급"
    }
  }
