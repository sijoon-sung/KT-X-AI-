  "rebalancing_failure_diagnostics": {
    "seoul_ttareungi_rebalance_pathology": {
      "core_bottleneck": "양방향 물리적 거치대 포화(Physical Dock Saturation) + 출근길 교통 체증 지연(Traffic Congestion Lag)",
      "mechanism": "서울 대여소의 22.1%가 지하철 역세권에 위치하며 평균 거치대 수는 대여소당 12.8대에 불과함. 출근 시간(08:00~08:45)에 여의도, 강남, 가산디지털단지 등 주요 업무 거점으로 시간당 수백 대가 쏟아져 유입되나, 15개 거치대가 5분 만에 만차(Full)가 되어 반납 불가/지연 대란 발생. 반대로 강서·노원·은평 등 외곽 주거지(Bed-town) 대여소는 30분 만에 완전 품절(Stockout). 이 시간대 서울 간선도로의 극심한 정체로 인해 1톤 재배치 트럭의 주행 속도가 15km/h 이하로 저하되어, 실시간 순환 재배치가 물리적으로 불가능하고 출근 시간이 지난 뒤에야 트럭이 도착하는 '피크 타임 무력화 현상' 발생.",
      "severity_index": "초고위험 (출퇴근 시간대 공급-수거 양방향 절단 동시 발생)"
    },
    "daejeon_tashu_rebalance_pathology": {
      "core_bottleneck": "외곽 저수요 롱테일 고갈(Peripheral Long-tail Starvation) + 24시간 초과 정비/이동 지연(Depot Latency)",
      "mechanism": "대전 타슈는 시즌2 도입으로 가상 거치대(Geofence) 시스템을 채택하여 거치대 만차로 인한 반납 실패 문제는 사실상 0%. 하지만 81,818건의 실측 트럭 재배치 데이터를 분석한 결과, 재배치 반응 시간의 중앙값이 43.4시간(1.8일)에 달하며 24시간 초과 지연 이동이 61.1%를 차지함. 트럭 재배치의 25%가 중앙정비센터(ST1220)로의 입고/출고에 집중되어 있어, 도심(둔산·유성)으로 한번 빨려 들어간 자전거가 외곽 주거지(동구·대덕구 롱테일 거점)로 자연 순환되지 못하고 외곽 대여소의 품절율(Stockout Rate 71.2%)이 만성적으로 방치되는 불균형 발생.",
      "severity_index": "중고위험 (외곽 접근성 소외 및 자전거 편중 쏠림)"
    },
    "methodological_insight_matrix": {
      "data_scale_vs_fidelity": {
        "seoul": "대규모(Millions), 고밀도(역세권 중심)이나 자전거 개체 식별 궤적 추적 및 정밀 재고 상태 파악에 제약",
        "tashu": "중규모(1,425개소)이나 개별 자전거 번호(ID) 연속 이력 기반으로 완전한 재고 복원, 트럭 이동 분리, 음이항 절단 수요 복원 가능"
      },
      "operational_recommendation": {
        "seoul": "피크 시간대 트럭 의존 지양 -> 시민 참여형 마일리지 인센티브(만차역 -> 인근 역 유도 반납) 시스템 필수",
        "tashu": "도심 집중 보충을 줄이고 롱테일 외곽 대여소 전담 순회 미니 셔틀 및 출근 전(06:30 이전) 사전 배치(Pre-fill) 강화"
      }
    }
