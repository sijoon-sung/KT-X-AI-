# Virtual environments & IDE
.vscode/
.idea/
.venv/
*.sublime-workspace
.DS_Store

# Logs and runtime artifacts
*.log
*.log.*
nohup.out

# Large binary datasets, databases, and checkpoints (>10MB / generated artifacts)
*.pt
*.pth
*.ckpt
*.bin
*.npz
*.npy
*.zip
*.tar
*.gz
*.db
*.sqlite
*.sqlite3

# Massive serialized models / dumps (>100MB)
**/models/**/*.json
**/models/**/*.pt
models/
**/models/

# Local scratch / test temp
scratch/
tmp/
temp/

# Contest runs are regenerated from explicit inputs; never mix them with source.
runs/
.pytest_cache/
*.egg-info/
